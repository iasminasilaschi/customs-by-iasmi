# Copy to .env.local for local development (never commit real values).
# In production, set these in Vercel: Project → Settings → Environment Variables.

# Password for the private /design-lab page (HTTP Basic Auth; any username works).
# If this is missing, /design-lab stays locked for everyone.
DESIGN_LAB_PASSWORD=

# Resend API key, used by /api/contact to email me the contact form (starts with re_).
RESEND_API_KEY=

# Where contact form messages are delivered.
# While sending from onboarding@resend.dev, this must be the email address of your Resend account.
CONTACT_TO_EMAIL=

# Optional: the sender, once a domain is verified in Resend, e.g.
# CONTACT_FROM_EMAIL="Customs by Iasmi <hello@iasmi.ro>"
# Default: Customs by Iasmi <onboarding@resend.dev>
CONTACT_FROM_EMAIL=
